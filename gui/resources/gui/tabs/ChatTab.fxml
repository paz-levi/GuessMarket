<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!-- The Chat tab's content: a global message list over a text field + Send button. Chat is only meaningful under
     Exercise 3's HTTP client, so this starts hidden behind a "logged in required" placeholder, exactly like
     UsersTab's own "No file loaded" gate; ChatTabController.setUsername flips it once a real login exists. -->
<StackPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
           fx:controller="gui.tabs.ChatTabController">
    <VBox fx:id="chatContentBox" spacing="10" visible="false" managed="false">
        <padding>
            <Insets top="14" right="14" bottom="14" left="14" />
        </padding>
        <ListView fx:id="chatListView" VBox.vgrow="ALWAYS" />
        <HBox spacing="8">
            <TextField fx:id="messageField" promptText="Type a message..." HBox.hgrow="ALWAYS" />
            <Button fx:id="sendButton" text="Send" />
        </HBox>
    </VBox>
    <Label fx:id="chatUnavailableLabel" text="Chat is only available when logged in; use the Exercise 3 client." wrapText="true" />
</StackPane>
