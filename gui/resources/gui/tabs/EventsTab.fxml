<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!-- The Events tab's content: a filtered event list on the left, one event's details on the right. The whole
     SplitPane starts hidden behind a "No file loaded" placeholder (visible/managed both false) until
     EventsTabController.revealLoadedContent() flips it, so nothing here (filters included) is interactable
     before a file is loaded. -->
<StackPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
           fx:controller="gui.tabs.EventsTabController">
    <SplitPane fx:id="eventsSplitPane" dividerPositions="0.48" visible="false" managed="false">
        <VBox spacing="6">
            <HBox fx:id="eventsToolBar" spacing="8">
                <Button fx:id="createEventButton" text="Create Event" />
            </HBox>
            <!-- A wrapping FlowPane of label+combobox pairs, not a single HBox row: at the app's minimum window
                 width the left pane cannot fit all six items side by side at any prefWidth, so the pairs wrap onto
                 additional lines instead of truncating to ellipsis. -->
            <FlowPane fx:id="eventFilterBar" hgap="16" vgap="6" styleClass="header-bar">
                <padding>
                    <Insets top="8" right="8" bottom="8" left="8" />
                </padding>
                <HBox spacing="6" alignment="CENTER_LEFT">
                    <Label text="Method:" />
                    <ComboBox fx:id="methodFilterComboBox" prefWidth="130" minWidth="70" />
                </HBox>
                <HBox spacing="6" alignment="CENTER_LEFT">
                    <Label text="Status:" />
                    <ComboBox fx:id="statusFilterComboBox" prefWidth="130" minWidth="70" />
                </HBox>
                <HBox spacing="6" alignment="CENTER_LEFT">
                    <Label text="Commission:" />
                    <ComboBox fx:id="commissionFilterComboBox" prefWidth="130" minWidth="70" />
                </HBox>
            </FlowPane>
            <ListView fx:id="eventsListView" VBox.vgrow="ALWAYS" />
        </VBox>
        <ScrollPane fitToWidth="true">
            <VBox fx:id="eventDetailsBox" spacing="10">
                <padding>
                    <Insets top="14" right="14" bottom="14" left="14" />
                </padding>
                <Label text="Select an event to view details" />
            </VBox>
        </ScrollPane>
    </SplitPane>
    <Label fx:id="eventsNoFileLabel" text="No file loaded — load a file to begin." />
</StackPane>
