<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!-- Exercise 3's login screen, shown before the main shell. See client.LoginController for the POST /login flow
     and the inline-retry behavior on a duplicate name (409). A plain VBox centered on a StackPane, not a full
     BorderPane shell -- this screen is replaced wholesale once login succeeds, not resized/reused afterward. -->
<StackPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
           fx:controller="client.LoginController">
    <VBox spacing="14" alignment="CENTER" maxWidth="360" maxHeight="-Infinity">
        <padding>
            <Insets top="40" right="40" bottom="40" left="40" />
        </padding>
        <Label text="Guess Market" styleClass="section-header" />
        <Label text="Enter a username to continue. Names must be unique across everyone currently on this server."
               wrapText="true" textAlignment="CENTER" />
        <TextField fx:id="usernameField" promptText="Username" />
        <Label fx:id="errorLabel" wrapText="true" textAlignment="CENTER" style="-fx-text-fill: #c0392b;" />
        <Button fx:id="loginButton" text="Log In" defaultButton="true" />
        <ProgressIndicator fx:id="loginProgressIndicator" prefWidth="24" prefHeight="24" visible="false" managed="false" />
    </VBox>
</StackPane>
