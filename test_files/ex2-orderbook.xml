<?xml version="1.0" encoding="UTF-8"?>
<Guess-Market xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="GM-EX2-Schema.xsd">
	<GM-events>
		<GM-event name="Rain Tomorrow">
			<id>1</id>
			<description>An Order Book event: will it rain tomorrow?</description>
			<commission type="on-purchase">10</commission>
			<GM-options>
				<GM-option>Yes</GM-option>
				<GM-option>No</GM-option>
			</GM-options>
			<GM-method>
				<GM-order-book allow-mint="true" initial="100" d="1"/>
			</GM-method>
		</GM-event>
		<GM-event name="World Cup Winner">
			<id>2</id>
			<description>An LMSR event, so both trading methods load from one file.</description>
			<commission type="on-close">15</commission>
			<GM-options>
				<GM-option>Argentina</GM-option>
				<GM-option>Spain</GM-option>
			</GM-options>
			<GM-method>
				<GM-LMSR>
					<b>50</b>
				</GM-LMSR>
			</GM-method>
		</GM-event>
	</GM-events>
	<GM-users>
		<GM-user name="Zoe">
			<initial-cash>1000</initial-cash>
			<GM-market-maker>
				<event id="1"/>
			</GM-market-maker>
		</GM-user>
		<GM-user name="Tikva">
			<initial-cash>500</initial-cash>
			<GM-market-maker>
				<event id="2"/>
			</GM-market-maker>
		</GM-user>
		<GM-user name="Bob">
			<initial-cash>500</initial-cash>
		</GM-user>
		<GM-user name="Carol">
			<initial-cash>500</initial-cash>
		</GM-user>
	</GM-users>
</Guess-Market>
