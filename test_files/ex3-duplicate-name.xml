<?xml version="1.0" encoding="UTF-8"?>
<!-- Ex3 fixture: two events sharing one name. The name is an event's identity now that the schema has no id, so
     this file must be rejected outright - the within-one-file half of the uniqueness rule. -->
<Guess-Market xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="GM-EX3-Schema.xsd">
	<GM-events>
		<GM-event name="Repeated Event">
			<description>The first event carrying this name</description>
			<commission type="on-purchase">5</commission>
			<GM-options>
				<GM-option>Yes</GM-option>
				<GM-option>No</GM-option>
			</GM-options>
			<GM-method>
				<GM-LMSR>
					<b>100</b>
				</GM-LMSR>
			</GM-method>
		</GM-event>
		<GM-event name="Repeated Event">
			<description>A second event carrying the very same name</description>
			<commission type="on-close">10</commission>
			<GM-options>
				<GM-option>Yes</GM-option>
				<GM-option>No</GM-option>
			</GM-options>
			<GM-method>
				<GM-LMSR>
					<b>100</b>
				</GM-LMSR>
			</GM-method>
		</GM-event>
	</GM-events>
</Guess-Market>
